{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "backfill:financial-snapshots": "node --experimental-strip-types src/scripts/backfillFinancialMonthSnapshots.ts",
    "cleanup:historical-financial-uploads": "node --experimental-strip-types src/scripts/cleanupHistoricalFinancialUploads.ts",
    "pretypecheck": "node ../../scripts/build-artifact-references.mjs",
    "typecheck": "pnpm run typecheck:workspace",
    "typecheck:workspace": "pnpm --filter @workspace/db run check-exports && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @workspace/db run check-schema && node --test --experimental-strip-types src/**/*.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.64",
    "@clerk/shared": "^4.30.2",
    "@google-cloud/storage": "^8.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.0.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
